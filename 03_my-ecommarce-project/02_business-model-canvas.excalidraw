    {
      "id": "bmc_text_0_6bi4hh",
      "type": "text",
      "x": -1025,
      "y": 366,
      "width": 184.51696256490845,
      "height": 64.19999999999996,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
