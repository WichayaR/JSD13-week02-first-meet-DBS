      "index": "b05",
      "roundness": null,
      "seed": 1975699707,
      "version": 54,
      "versionNonce": 979875027,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783927233871,
      "link": null,
      "locked": false,
      "text": "• คอมมูนิตี้นักอ่านที่เป็นกันเอง\n• ระบบแนะนำหนังสือตามความชอบ\n• บริการลูกค้าและจดหมายข่าว",
      "fontSize": 14.23157894736842,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• คอมมูนิตี้นักอ่านที่เป็นกันเอง\n• ระบบแนะนำหนังสือตามความชอบ\n• บริการลูกค้าและจดหมายข่าว",
      "autoResize": true,
      "lineHeight": 1.3
    },
    {
      "id": "bmc_text_5_tjr5os",
      "type": "text",
      "x": -374,
      "y": 564,
      "width": 189.45155334472656,
      "height": 47.58181935094694,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
